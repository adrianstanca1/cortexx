{
  "expo": {
    "name": "Cortexx",
    "slug": "cortexx",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "cortexbuild",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06101e",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.cortexbuild.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:cortexbuildpro.tech"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cortexbuild.app",
      "adaptiveIcon": {
        "backgroundColor": "#06101e"
      },
      "versionCode": 2
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceID": true
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "https://cortexbuildpro.tech",
      "eas": {
        "projectId": "76a768f6-ab7d-4c25-b71d-4b978a32ef61"
      }
    },
    "owner": "adrianstanca"
  }
}
