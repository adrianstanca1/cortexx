# Browser Gateway — required environment variables
#
# Copy to the repo-root .env (gitignored, age-encrypted as .env.vault — see
# VAULT.md) and set BROWSER_GATEWAY_JWT_SECRET there. docker-compose.yml maps
# it to JWT_SECRET inside the container.
#
# The gateway REFUSES TO BOOT if JWT_SECRET is unset. Do not add a default
# fallback: this service drives a Puppeteer browser instance, so a guessable
# secret is a full control-plane compromise.
#
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

BROWSER_GATEWAY_JWT_SECRET=

# Where the gateway reaches redis in the compose network.
REDIS_HOST=redis
REDIS_PORT=6379

# Origin allowed to call the gateway / open Socket.IO connections.
# Must match the public site origin. Override only for a split-host setup.
ALLOWED_ORIGIN=https://cortexbuildpro.tech

# Optional: custom domain for Caddy automatic HTTPS
SITE_ADDRESS=cortexbuildpro.tech