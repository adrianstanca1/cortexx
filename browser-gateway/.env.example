# Internal-only service credential. Generate a unique random value:
# openssl rand -hex 48
BROWSER_GATEWAY_INTERNAL_TOKEN=
REDIS_URL=redis://redis:6379
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
MAX_BROWSER_SESSIONS=4
BROWSER_SESSION_IDLE_MS=900000
# Optional comma-separated exceptions for deliberately allowed private hosts.
BROWSER_GATEWAY_ALLOWED_PRIVATE_HOSTS=
