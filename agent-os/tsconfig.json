{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts", "apps/cli/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["apps/mobile/**/*"]
}