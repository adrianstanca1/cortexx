{$SITE_ADDRESS} {
	root * /srv/app
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3001
	}

	@blocked path /.git* /.env* /.env.production /.env.vault /server/* /build-dist.js *.ts *.tsx
	handle @blocked {
		respond 404
	}

	handle {
		try_files {path} /landing.html /Cortexx.html
		file_server {
			hide .git .env .env.* server *.ts *.tsx build-dist.js proxy.ts package.json package-lock.json tsconfig.json next.config.js tailwind.config.js
		}
	}

	@appcode path /lib/* /dist/*
	header @appcode Cache-Control "no-cache, must-revalidate"

	@static path *.js *.css *.png *.jpg *.svg *.woff2 not path /lib/* /dist/* /sw.js /admin.js
	header @static Cache-Control "public, max-age=31536000, immutable"
	header /sw.js Cache-Control "no-cache, must-revalidate"
	@html path *.html
	header @html Cache-Control "no-cache"
}
