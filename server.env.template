# CortexBuild Pro — server environment
# Copy to server/.env and edit. Never commit the real .env.
#
# Auto-filled by deploy-vps.sh / deploy-vps-full.sh — the placeholders
# below are overwritten at deploy time. Manual deploys: generate secrets
# with `openssl rand -hex 32` and fill in DATABASE_URL with the real
# postgres password (NOT the literal string ${POSTGRES_PASSWORD}).

NODE_ENV=production
PORT=3001
APP_URL=https://cortexbuildpro.tech
CORS_ORIGINS=https://cortexbuildpro.tech,http://cortexbuildpro.tech:8080

# ── Generated secrets (auto-filled by deploy script) ──
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-generate-openssl-rand-hex-32
WEBHOOK_SECRET=change-me-generate-random-string
BANKING_ENC_KEY=change-me-generate-openssl-rand-hex-32
NEXTAUTH_SECRET=change-me-generate-openssl-rand-hex-32

# ── Database ──
# IMPORTANT: the password must be the REAL postgres password, not the
# literal placeholder ${POSTGRES_PASSWORD}. The deploy script substitutes this at runtime.
DATABASE_URL=postgres://postgres:REPLACE_WITH_REAL_PASSWORD@db:5432/cortexx

# ── AI runtime ──
LLM_RUNTIME=ollama
OLLAMA_BASE=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llava
LLM_TIMEOUT_MS=60000

# ── Optional integrations (fill in later) ──
ANTHROPIC_API_KEY=
RESEND_API_KEY=
MAIL_FROM=CortexBuild Pro <login@cortexbuildpro.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sales@cortexbuildpro.com
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=https://cortexbuildpro.com/api/banking/callback
TRUELAYER_ENV=sandbox
PUBLIC_BASE_URL=https://cortexbuildpro.com
APPLE_SHARED_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_BASE=https://api.gocardless.com
BANK_ACCOUNT_NAME=CortexBuild Ltd
BANK_SORT_CODE=
BANK_ACCOUNT_NO=
BANK_IBAN=
HMRC_GATEWAY_USER=
HMRC_GATEWAY_PASS=
HMRC_ENV=tpvs
HMRC_VENDOR_ID=0000
SENTRY_DSN=
WA_VERIFY_TOKEN=
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
